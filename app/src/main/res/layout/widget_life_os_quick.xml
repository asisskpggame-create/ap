<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0B0C0E"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personal Life OS • ثبت سریع زیر ۲ ثانیه"
        android:textColor="#00E5CC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/widget_btn_water"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#171B24"
            android:text="+۲۵۰ml آب"
            android:textColor="#38BDF8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_espresso"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#171B24"
            android:text="+دبل ۹۰ت"
            android:textColor="#F59E0B"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_voice"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:backgroundTint="#00E5CC"
            android:text="🎤 وویس"
            android:textColor="#00201C"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
